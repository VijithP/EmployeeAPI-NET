{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "EmployeePortal.Api",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: EmployeePortal.Api",
      "program": "${workspaceFolder}/EmployeePortal.Api/bin/Debug/net10.0/EmployeePortal.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/EmployeePortal.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7007;http://localhost:5209"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "uriFormat": "https://localhost:7007/swagger",
        "pattern": "Now listening on: https://localhost:7007"
      },
      "logging": {
        "moduleLoad": false
      }
    }
  ]
}
